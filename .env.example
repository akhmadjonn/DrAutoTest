# DrAutoTest Environment Variables
# Copy this to .env and fill in real values

# Database
DB_PASSWORD=StrongPassword123!

# Redis
REDIS_PASSWORD=RedisPassword123!

# JWT
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32CharactersLong!

# MinIO / Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# SMS Provider (e.g., Eskiz.uz, Twilio)
SMS_API_URL=https://notify.eskiz.uz/api
SMS_API_TOKEN=your_sms_api_token

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@drautotest.uz

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payment - Payme
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# Payment - Click
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
